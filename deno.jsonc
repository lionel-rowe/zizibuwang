{
	"name": "zizibuwang",
	"version": "0.1.0",
	"lock": false,
	"exports": {},
	"tasks": {
		"start": "deno run -A npm:react-scripts start",
		"build": "deno run -A npm:react-scripts build",
		"test": "deno test --allow-read",
		"predeploy": "deno task build",
		"deploy": "deno task test && deno run -A npm:gh-pages -d build",
		"parse-cedict": "deno run --allow-read --allow-write scripts/parse-cc-cedict.ts",
		"db-bump": "deno run --allow-write scripts/db-bump.ts"
	},
	"imports": {
		"@std/assert": "jsr:@std/assert@^1.0.19"
	},
	"fmt": {
		"semiColons": false,
		"useTabs": true,
		"lineWidth": 120,
		"indentWidth": 4,
		"singleQuote": true,
		"proseWrap": "preserve",
		"exclude": []
	},
	"compilerOptions": {
		"strict": true,
		"useUnknownInCatchVariables": true,
		"lib": [
			"deno.window",
			"deno.unstable",
			"dom",
			"dom.iterable"
		]
	},
	"lint": {
		"exclude": [],
		"rules": {
			"tags": ["recommended"],
			"exclude": ["no-window", "no-window-prefix"],
			"include": ["no-console"]
		}
	},
	"exclude": []
}
